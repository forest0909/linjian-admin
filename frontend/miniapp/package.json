{
  "name": "linjian-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "林间 Admin 微信小程序脚手架（Taro 4 + React 18）",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mp-weixin": "taro build --type weapp --watch",
    "build:mp-weixin": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"config/**/*.ts\" --max-warnings 0",
    "test": "vitest run"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/nutui-react-taro": "4.0.0",
    "@tarojs/components": "4.3.3",
    "@tarojs/helper": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-html": "4.3.3",
    "@tarojs/plugin-platform-h5": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "crypto-js": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.3.3",
    "@tarojs/taro-loader": "4.3.3",
    "@tarojs/webpack5-runner": "4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^18.3.0",
    "@types/webpack-env": "^1.13.6",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.3.3",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.3.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6",
    "webpack": "5.91.0"
  }
}
