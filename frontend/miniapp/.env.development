# 开发构建（npm run dev:*）读这个文件。只有 TARO_APP_ 开头的变量会进代码。
# 配置说明：https://taro-docs.jd.com/docs/next/env-mode-config

# 后端地址。H5 留空，走 devServer 代理（/admin → :7788）。
# 小程序开发者工具里调试时填完整地址，例如 http://localhost:7788，并关掉「校验合法域名」。
TARO_APP_API_BASE=

# 口令传输的 AES key，和管理端 frontend/admin/react/.env 的 VITE_AES_KEY 一致。
# 它会打进前端包，是公开常量，保密靠 HTTPS。
TARO_APP_AES_KEY=f51d66a73d8a0927

# 'true' 时不调微信，wx.login 和手机号授权返回 mock code（配合后端的 mock 开发构建），
# 登录页多一个手机号输入框，H5 下也能走一键登录和静默续期。
# 临时打开：TARO_APP_WECHAT_MOCK=true npm run dev:h5（命令行的值优先于本文件）。
# 长期打开：写进 .env.development.local（不进版本库）。
TARO_APP_WECHAT_MOCK=false
