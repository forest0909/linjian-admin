{
  "root": true,
  "extends": ["taro/react"],
  "rules": {
    "react/jsx-uses-react": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      // 单测里 vi.mock / vi.hoisted 必须写在被测模块的 import 之前
      "files": ["src/**/*.test.ts"],
      "rules": {
        "import/first": "off"
      }
    }
  ]
}
